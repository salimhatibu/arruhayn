# Copy to .env for local development. Never commit .env.

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Local development only: you are signed in to the admin as this staff email,
# standing in for Cloudflare Access. Ignored in production.
DEV_STAFF_EMAIL=you@example.com

# Cloudflare Access (admin Worker). Zero Trust > Settings, and the Access application's AUD tag.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Turnstile. The test secret below always passes; use the real one in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# RealtimeKit (live classes). Account ID, app ID, and an API token with the Realtime permission.
RTK_ACCOUNT_ID=
RTK_APP_ID=
RTK_API_TOKEN=

# R2 API token for direct uploads (Object Read and Write on arruhayn-media only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
